# Local teaching values only. Generate your own random secrets; never reuse these anywhere real.
NODE_ENV=development
PORT=3000
# 127.0.0.1 keeps the lab off the network. Docker sets 0.0.0.0 inside the container and binds the host port to 127.0.0.1.
HOST=127.0.0.1
# false disables /lab/reset and /lab/tokens.
DEMO_MODE=true
# false disables the deliberately broken modes: naive JWT verifier, session replay, cookie-only logout.
LAB_VULNERABLE_MODES=true

FRONTEND_ORIGIN=http://localhost:5173

SESSION_SECRET=replace-with-local-random-secret
# Set to true only when serving over HTTPS, otherwise the browser drops the cookie.
SESSION_COOKIE_SECURE=false

JWT_SECRET=replace-with-local-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=120

# OIDC (Demo 7). Leave the issuer or client id empty to keep the labelled walkthrough.
# Fill both to switch to a real Authorization Code + PKCE login against your Identity Provider.
# Register this redirect URI at the IdP:        http://localhost:3000/oidc/callback
# Register this post-logout URI (optional):     http://localhost:5173/demo/oidc
# The IdP must sign ID tokens with an asymmetric key published in its JWKS (RS256, ES256, ...).
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
# Empty for a public client (PKCE only). When set, it is sent as client_secret_post.
OIDC_CLIENT_SECRET=

# Optional; the values shown are the defaults.
# OIDC_REDIRECT_URI=http://localhost:3000/oidc/callback
# OIDC_SCOPES=openid profile email
# OIDC_RETURN_TO=http://localhost:5173/demo/oidc
# Comma-separated emails that get role=admin after an OIDC login; everyone else is member.
# OIDC_ADMIN_EMAILS=
