{
  "name": "devhub-auth-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Educational NestJS lab for Authentication Core: JWT verification, password hashing, and sessions/cookies.",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "lab:jwt": "ts-node scripts/jwt-tampering.ts",
    "lab:password": "ts-node scripts/benchmark-password-hash.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test:e2e": "jest --runInBand test/",
    "test:unit": "jest --runInBand src/"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "bcryptjs": "^2.4.3",
    "express-session": "^1.18.1",
    "jsonwebtoken": "^9.0.2",
    "openid-client": "^6.8.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.spec.json"
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(openid-client|oauth4webapi|jose)/)"
    ],
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.ts"
    ]
  }
}
